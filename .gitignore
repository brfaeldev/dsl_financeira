# ============================================================================
# Regras de Exclusao de Versionamento Git (.gitignore)
#
# Define artefatos de build, caches do Python e ambientes virtuais ignorados pelo Git.
# ============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/

# Test, coverage, and linter caches
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/

# Environment variables
.env
.env.*

# Arquivos temporarios e logs
*.log
tmp/
temp/

# Editores / IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Arquivos do sistema operacional
.DS_Store
Thumbs.db
desktop.ini
