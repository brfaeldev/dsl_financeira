// ============================================================================
// Especificacao da Gramatica Formal EBNF (gramatica.lark)
//
// Define as regras sintaticas (declaracoes de indexadores, investimentos,
// parametros financeiros/tributarios e comandos de saida/simulacao) e os
// padroes lexicos utilizados pelo gerador de parsers Lark para construir a AST.
// ============================================================================
//
// Gramatica em notacao EBNF (equivalente ao Codigo 1 do artigo):
// programa         ::= (decl_indice | declaracao | comando)+
// decl_indice      ::= "INDICE" STRING numero "PORCENTO" UNIDADE_TAXA
// declaracao       ::= "INVESTIMENTO" STRING bloco_parametros "FIM"
// bloco_parametros ::= parametro+
// parametro        ::= "VALOR_INICIAL" numero
//                    | "APORTE" numero "POR" INT UNIDADE_PERIODO
//                    | "APORTE_EXTRA" numero "NO_MES" INT
//                    | "RESGATE" numero "NO_MES" INT
//                    | "PERIODO" INT UNIDADE_PERIODO
//                    | "TAXA" numero "PORCENTO" UNIDADE_TAXA
//                    | "TAXA" numero "PORCENTO" "DO" STRING
//                    | "TAXA" STRING "+" numero "PORCENTO" UNIDADE_TAXA
//                    | "TAXA" numero "PORCENTO" UNIDADE_TAXA "+" STRING
//                    | "TAXA_ADMINISTRACAO" numero "PORCENTO" UNIDADE_TAXA
//                    | "INFLACAO" numero "PORCENTO" UNIDADE_TAXA
//                    | "INFLACAO" STRING
//                    | "IMPOSTO" numero "PORCENTO"
//                    | "IMPOSTO" "REGRESSIVO" ["POR_SAFRA"]
//                    | "IMPOSTO" "COME_COTAS"
// comando          ::= "IMPRIMIR" "RESUMO" STRING
//                    | "GERAR" "GRAFICO" STRING+
//                    | "GERAR" "GRAFICO_INTERATIVO" STRING+
//                    | "COMPARAR" "GRAFICO" STRING STRING+
//                    | "EXPORTAR" ("CSV" | "JSON") STRING+
//                    | "GERAR" "RELATORIO" STRING+
//                    | "SIMULAR" "RENDA" STRING "RETIRADA" numero UNIDADE_TAXA
// numero           ::= NUMBER | INT

// Regra inicial: um script .dsl contem declaracoes de indices, investimentos e/ou comandos
programa: (decl_indice | declaracao | comando)+

// Declaracao global de um indexador macroeconomico (ex.: CDI, SELIC, IPCA)
decl_indice: "INDICE" STRING numero "PORCENTO" UNIDADE_TAXA

// Bloco declarativo que registra um novo cenario de investimento na Tabela de Simbolos
declaracao: "INVESTIMENTO" STRING bloco_parametros "FIM"

bloco_parametros: parametro+

// O prefixo '?' (inline rule do Lark) achata o no intermediario na AST, fazendo
// a arvore expor diretamente a regra filha para despacho automatico no AST Visitor.
?parametro: valor_inicial
          | aporte
          | aporte_extra
          | resgate
          | periodo
          | taxa
          | taxa_administracao
          | inflacao
          | imposto
          | imposto_regressivo
          | imposto_regressivo_safra
          | imposto_come_cotas

valor_inicial: "VALOR_INICIAL" numero
aporte: "APORTE" numero "POR" INT UNIDADE_PERIODO
aporte_extra: "APORTE_EXTRA" numero "NO_MES" INT
resgate: "RESGATE" numero "NO_MES" INT
periodo: "PERIODO" INT UNIDADE_PERIODO

taxa: "TAXA" numero "PORCENTO" UNIDADE_TAXA
    | "TAXA" numero "PORCENTO" "DO" STRING             -> taxa_indexada
    | "TAXA" STRING "+" numero "PORCENTO" UNIDADE_TAXA -> taxa_hibrida_indice_primeiro
    | "TAXA" numero "PORCENTO" UNIDADE_TAXA "+" STRING -> taxa_hibrida_fixa_primeiro

taxa_administracao: "TAXA_ADMINISTRACAO" numero "PORCENTO" UNIDADE_TAXA

inflacao: "INFLACAO" numero "PORCENTO" UNIDADE_TAXA
        | "INFLACAO" STRING -> inflacao_indice

imposto: "IMPOSTO" numero "PORCENTO"
imposto_regressivo: "IMPOSTO" "REGRESSIVO"
imposto_regressivo_safra: "IMPOSTO" "REGRESSIVO" "POR_SAFRA"
imposto_come_cotas: "IMPOSTO" "COME_COTAS"

// Regra inline que aceita tanto literais decimais (NUMBER) quanto inteiros (INT),
// mantendo os tokens lexicos disjuntos para compatibilidade entre LALR(1) e Earley.
?numero: NUMBER | INT

// Regras de acao executadas pelo Interpretador apos a validacao semantica
?comando: imprimir_resumo
        | gerar_grafico
        | gerar_grafico_interativo
        | comparar_grafico
        | exportar_csv
        | exportar_json
        | gerar_relatorio
        | simular_renda

imprimir_resumo: "IMPRIMIR" "RESUMO" STRING
gerar_grafico: "GERAR" "GRAFICO" STRING+
gerar_grafico_interativo: "GERAR" "GRAFICO_INTERATIVO" STRING+
// COMPARAR GRAFICO exige ao menos dois identificadores na propria gramatica
comparar_grafico: "COMPARAR" "GRAFICO" STRING STRING+
exportar_csv: "EXPORTAR" "CSV" STRING+
exportar_json: "EXPORTAR" "JSON" STRING+
gerar_relatorio: "GERAR" "RELATORIO" STRING+
simular_renda: "SIMULAR" "RENDA" STRING "RETIRADA" numero UNIDADE_TAXA

// Tokens lexicos:
// NUMBER (decimais) e INT (inteiros) sao disjuntos e aceitam sinal negativo
// opcional ('-?') no Lexer para que valores negativos nao gerem erro de sintaxe
// obscuro, sendo capturados na Analise Semantica com diagnostico especifico de
// dominio (ValorForaDoDominioError).
UNIDADE_PERIODO: "MESES" | "ANOS"
UNIDADE_TAXA: "AO_MES" | "AO_ANO"
STRING: /"[^"\r\n]*"/
NUMBER: /-?[0-9]+\.[0-9]+/
INT: /-?[0-9]+/

// Ignora espacos em branco, quebras de linha e comentarios iniciados por '#'
%import common.WS
%ignore WS
%ignore /#[^\n]*/
