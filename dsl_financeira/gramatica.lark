// ============================================================================
// Especificacao da Gramatica Formal EBNF (gramatica.lark)
//
// Define as regras sintaticas (declaracoes de investimento, parametros e
// comandos de saida) e os padroes lexicos (identificadores, numeros e
// comentarios) utilizados pelo gerador de parsers Lark para construir a AST.
// ============================================================================
//
// Gramatica em notacao EBNF (conforme o artigo IEEE):
// programa          ::= (declaracao | comando)+
// declaracao        ::= "INVESTIMENTO" STRING bloco_parametros "FIM"
// bloco_parametros  ::= parametro+
// parametro         ::= "VALOR_INICIAL" NUMBER
//                     | "APORTE" NUMBER "POR" INT "MESES"
//                     | "PERIODO" INT "MESES"
//                     | "TAXA" NUMBER "PORCENTO" "AO_MES"
//                     | "IMPOSTO" NUMBER "PORCENTO"
//                     | "IMPOSTO" "REGRESSIVO"
// comando           ::= "IMPRIMIR" "RESUMO" STRING
//                     | "GERAR" "GRAFICO" STRING+
//                     | "COMPARAR" "GRAFICO" STRING STRING+

// Regra inicial: um script .dsl contem uma ou mais declaracoes e/ou comandos
programa: (declaracao | comando)+

// Bloco declarativo que registra um novo cenario de investimento na Tabela de Simbolos
declaracao: "INVESTIMENTO" STRING bloco_parametros "FIM"

bloco_parametros: parametro+

// O prefixo '?' (inline rule do Lark) achata o no intermediario na AST, fazendo
// a arvore expor diretamente a regra filha (ex.: valor_inicial, aporte, taxa)
// para despacho automatico nos metodos do AST Visitor (Interpreter).
?parametro: valor_inicial
          | aporte
          | periodo
          | taxa
          | imposto
          | imposto_regressivo

valor_inicial: "VALOR_INICIAL" numero
aporte: "APORTE" numero "POR" INT "MESES"
periodo: "PERIODO" INT "MESES"
taxa: "TAXA" numero "PORCENTO" "AO_MES"
imposto: "IMPOSTO" numero "PORCENTO"
imposto_regressivo: "IMPOSTO" "REGRESSIVO"

// Regra inline que aceita tanto literais decimais (NUMBER) quanto inteiros (INT),
// mantendo os tokens lexicos disjuntos para compatibilidade entre LALR(1) e Earley.
?numero: NUMBER | INT

// Regras de acao executadas pelo Interpretador apos a validacao semantica
?comando: imprimir_resumo
        | gerar_grafico
        | comparar_grafico

imprimir_resumo: "IMPRIMIR" "RESUMO" STRING
gerar_grafico: "GERAR" "GRAFICO" STRING+
// COMPARAR GRAFICO exige ao menos dois identificadores na propria gramatica
comparar_grafico: "COMPARAR" "GRAFICO" STRING STRING+

// Tokens lexicos:
// NUMBER (decimais) e INT (inteiros) sao disjuntos e aceitam sinal negativo
// opcional ('-?') no Lexer para que valores negativos nao gerem erro de sintaxe
// obscuro, sendo capturados na Analise Semantica com diagnostico especifico de
// dominio (ValorForaDoDominioError).
STRING: /"[^"]*"/
NUMBER: /-?[0-9]+\.[0-9]+/
INT: /-?[0-9]+/

// Ignora espacos em branco, quebras de linha e comentarios iniciados por '#'
%import common.WS
%ignore WS
%ignore /#[^\n]*/
